{
    "name": "stageart/stageart",
    "description": "StageArt WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "StageArt\\Domain\\": "src/Domain/",
            "StageArt\\Application\\": "src/Application/",
            "StageArt\\Infrastructure\\": "src/Infrastructure/",
            "StageArt\\Presentation\\": "src/Presentation/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StageArt\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
